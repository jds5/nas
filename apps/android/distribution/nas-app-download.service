[Unit]
Description=NAS Remote LAN APK downloads

[Service]
Type=simple
WorkingDirectory=%h/code/nas
ExecStart=/usr/bin/python3 %h/code/nas/apps/android/distribution/serve.py --bind 192.168.50.33 --allow 192.168.50.0/24 --port 8765 --apk %h/code/nas/apps/android/distribution/build/nas-remote-0.4.2.apk --version 0.4.2
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0077
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=default.target
